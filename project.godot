; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Simple Space Game"
run/main_scene="res://Stages/RX93TestRange/rx93_test_range.tscn"
config/features=PackedStringArray("4.7", "Double Precision", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Layers="*uid://bi6ju22pgh4ru"
PerfOverlay="*res://Core/AutoLoad/perf_overlay.gd"

[dotnet]

project/assembly_name="Simple Space Game"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_linear_velocity=1000000.0
common/physics_interpolation=true
flight/native_kernels=true

[rendering]

driver/threads/thread_model=2
rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
